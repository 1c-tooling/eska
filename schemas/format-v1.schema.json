          "default": false
        },
        "space_inside_parentheses": {
          "type": "boolean",
          "default": false
        },
        "tab_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 4
        },
        "trim_trailing_whitespace": {
          "type": "boolean",
          "default": true
        },
        "wrap_arguments": {
          "enum": [
            "fit",
            "one_per_line",
