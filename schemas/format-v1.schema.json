        },
        "exclude": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "common": {
          "$ref": "#/$defs/common"
        },
        "bsl": {
