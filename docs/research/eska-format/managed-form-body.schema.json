{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eska:managed-form-body:1",
  "title": "Experimental managed-form dialog codec v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "elements": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:-1|0|[1-9][0-9]*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/element"
      }
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "native": {
      "$ref": "#/$defs/native"
    }
  },
  "required": [
    "schema_version",
    "elements",
    "layout",
    "native"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?:-1|0|[1-9][0-9]*)$"
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "AutoCommandBar",
            "Button",
            "ButtonGroup",
            "CalendarField",
            "ChartField",
            "CheckBoxField",
            "ColumnGroup",
            "CommandBar",
            "ContextMenu",
            "ExtendedTooltip",
            "FormattedDocumentField",
            "HTMLDocumentField",
            "InputField",
            "LabelDecoration",
            "LabelField",
            "Page",
            "Pages",
            "PictureDecoration",
            "PictureField",
            "Popup",
            "ProgressBarField",
            "RadioButtonField",
            "SearchControlAddition",
            "SearchStringAddition",
            "SpreadSheetDocumentField",
            "Table",
            "TextDocumentField",
            "UsualGroup",
            "ViewStatusAddition"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "children": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?:-1|0|[1-9][0-9]*)$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      },
      "required": [
        "roots",
        "children"
      ]
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "prefix",
        "uri"
      ]
    },
    "stencil": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespaces": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/namespace"
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        }
      },
      "required": [
        "parts"
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "open": {
          "type": "string"
        },
        "close": {
          "type": "string"
        },
        "gaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "empty": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "open",
        "close",
        "gaps"
      ]
    },
    "part": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "xml"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "name"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "id"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "class"
            },
            "prefix": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "prefix"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "element"
            },
            "id": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "children"
            },
            "frame": {
              "$ref": "#/$defs/frame"
            }
          },
          "required": [
            "kind",
            "frame"
          ]
        }
      ]
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namespace"
          }
        },
        "root": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "elements": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?:-1|0|[1-9][0-9]*)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/stencil"
          }
        }
      },
      "required": [
        "namespaces",
        "root",
        "elements"
      ]
    }
  }
}
