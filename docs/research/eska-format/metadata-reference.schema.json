{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ESKA named metadata reference list",
  "$ref": "#/$defs/list",
  "$defs": {
    "value": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z]+\\.[^\\s.:]+(?:\\.[A-Za-z]+\\.[^\\s.:]+)*$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/value"
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "item_prefix": {
          "type": "string",
          "minLength": 1
        },
        "xsi_prefix": {
          "type": "string",
          "minLength": 1
        },
        "type_prefix": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "item_prefix",
        "xsi_prefix",
        "type_prefix"
      ],
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "properties": {
        "items": {
          "$ref": "#/$defs/items"
        },
        "native": {
          "$ref": "#/$defs/layout"
        }
      },
      "required": [
        "items",
        "native"
      ],
      "additionalProperties": false
    }
  }
}
