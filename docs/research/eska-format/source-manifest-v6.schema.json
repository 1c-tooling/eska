{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ESKA external root reverse map 6",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 6
    },
    "rules_version": {
      "const": 1
    },
    "profile": {
      "enum": [
        "designer-2.20-external-data-processor",
        "designer-2.20-external-report"
      ]
    },
    "input_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "directories": {
      "type": "array",
      "items": {
        "$ref": "object-source.schema.json#/$defs/path"
      },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "object-source.schema.json#/$defs/path"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "descriptor"
                  },
                  "source": {
                    "$ref": "object-source.schema.json#/$defs/path"
                  },
                  "uuid": {
                    "$ref": "descriptor.schema.json#/$defs/uuid"
                  }
                },
                "required": [
                  "kind",
                  "source",
                  "uuid"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "preserved"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "relocated"
                  },
                  "source": {
                    "$ref": "object-source.schema.json#/$defs/path"
                  }
                },
                "required": [
                  "kind",
                  "source"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "managed_form"
                  },
                  "source": {
                    "$ref": "object-source.schema.json#/$defs/path"
                  },
                  "descriptor": {
                    "$ref": "object-source.schema.json#/$defs/path"
                  }
                },
                "required": [
                  "kind",
                  "source",
                  "descriptor"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "optional_module"
                  },
                  "source": {
                    "const": "ObjectModule.bsl"
                  }
                },
                "required": [
                  "kind",
                  "source"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256",
          "role"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "properties": {
                    "kind": {
                      "const": "optional_module"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "bytes": {
                  "const": 0
                },
                "sha256": {
                  "const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
                },
                "path": {
                  "pattern": "^(Ext|[^/]+/Ext)/ObjectModule\\.bsl$"
                }
              },
              "description": "The domain validator also binds the optional native path to external_root and refuses readable/binary alternatives."
            }
          }
        ]
      }
    },
    "descriptor_contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "object-source.schema.json#/$defs/path"
          },
          "metadata_kind": {
            "$ref": "descriptor.schema.json#/$defs/metadata_kind"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "oneOf": [
              {
                "$ref": "object-source.schema.json#/$defs/path"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "metadata_kind",
          "name",
          "parent"
        ],
        "additionalProperties": false
      }
    },
    "query_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "object-source.schema.json#/$defs/path"
          },
          "descriptor": {
            "$ref": "object-source.schema.json#/$defs/path"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "object-source.schema.json#/$defs/path"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "path",
          "descriptor",
          "sources"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "external_root": {
      "type": "object",
      "properties": {
        "path": {
          "allOf": [
            {
              "$ref": "object-source.schema.json#/$defs/path"
            },
            {
              "pattern": "^[^/]+\\.xml$"
            }
          ]
        },
        "kind": {
          "enum": [
            "processing",
            "report"
          ]
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "rules_version",
    "profile",
    "input_revision",
    "directories",
    "files",
    "descriptor_contexts",
    "external_root"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "external_root": {
            "properties": {
              "kind": {
                "const": "processing"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "profile": {
            "const": "designer-2.20-external-data-processor"
          }
        }
      },
      "else": {
        "properties": {
          "profile": {
            "const": "designer-2.20-external-report"
          }
        }
      }
    }
  ]
}
