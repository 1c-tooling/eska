{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit approved workspace accepted bases",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "members": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "not": {
          "pattern": "[^a-z0-9_-]"
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64,
        "pattern": "^[0-9a-fA-F]+$"
      }
    }
  },
  "required": [
    "schema_version",
    "members"
  ],
  "additionalProperties": false
}
