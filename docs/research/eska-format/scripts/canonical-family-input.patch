+/// Canonical inputs retain revisions and do not read unregistered XML file identities.
+#[test]
+fn canonical_mdo_tracks_value_and_pending_without_xml_fallback() {
+    use crate::metadata::{
+        config_index, resolve_metadata_object, CanonicalMetadata, CanonicalMetadataInput,
+        CanonicalMetadataInputs, MdoEntry,
+    };
+    use bsl_metadata::{Attribute, AttributeType, MdoType, MetadataObject};
+    use salsa::Setter;
+
+    let mut db = RootDatabaseImpl::new_with_salsa_events();
+    db.set_metadata_listing(
+        "/canonical",
+        MetadataListingData {
+            entries: vec![MdoEntry {
+                kind: MdoType::Catalog,
+                name: "Sample".into(),
+                main: FileId(0),
+                predefined: None,
+            }],
+            ..MetadataListingData::default()
+        },
+    );
+    let listing = db.metadata_listing("/canonical").expect("registered listing");
+    let mut object = MetadataObject::new(MdoType::Catalog, "Sample");
+    object.attributes.push(Attribute {
+        name: "SavedField".into(),
+        name_en: None,
+        attr_type: AttributeType::Unknown,
+    });
+    let input = CanonicalMetadataInput::new(
+        &db,
+        Some(Arc::new(CanonicalMetadata::Object(Arc::new(object.clone())))),
+        "saved".into(),
+    );
+    let inputs: CanonicalMetadataInputs = [(FileId(0), input)].into_iter().collect();
+    listing.set_canonical_metadata(&mut db).to(Arc::new(inputs));
+    let index = Arc::clone(config_index(&db, listing));
+    let saved = resolve_metadata_object(&db, listing, MdoType::Catalog, "Sample".into())
+        .expect("canonical value");
+    assert_eq!(saved.attributes[0].name, "SavedField");
+    object.attributes[0].name = "DraftField".into();
+    input.set_value(&mut db).to(Some(Arc::new(CanonicalMetadata::Object(Arc::new(object)))));
+    input.set_source_revision(&mut db).to("draft".into());
+    let draft = resolve_metadata_object(&db, listing, MdoType::Catalog, "Sample".into())
+        .expect("updated value");
+    assert_eq!(draft.attributes[0].name, "DraftField");
+    assert_eq!(saved.attributes[0].name, "SavedField");
+    assert!(Arc::ptr_eq(&index, config_index(&db, listing)));
+    input.set_value(&mut db).to(None);
+    input.set_source_revision(&mut db).to("pending".into());
+    assert!(resolve_metadata_object(&db, listing, MdoType::Catalog, "Sample".into()).is_none());
+    assert_eq!(db.salsa_family_churn("parse_mdo_query").expect("events").0, 0);
+}
