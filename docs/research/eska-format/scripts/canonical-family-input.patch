+                })
+                .collect(),
+            ..MetadataListingData::default()
+        },
+    );
+    let listing = db.metadata_listing("/canonical").expect("registered listing");
+    let first = CanonicalMetadataInput::new(
+        &db,
+        Some(Arc::new(CanonicalMetadata::Object(Arc::new(MetadataObject::new(
+            MdoType::Catalog,
