+/// Already parsed metadata families share the same versioned provider boundary.
+/// Inner Arcs let memoized resolvers share payloads without cloning their owned metadata.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum CanonicalMetadata {
+    Object(Arc<bsl_metadata::MetadataObject>),
+    Register(Arc<bsl_metadata::Register>),
+    CommonModule(Arc<bsl_metadata::CommonModule>),
+    DefinedType(Arc<bsl_metadata::DefinedType>),
+}
+
+impl CanonicalMetadata {
+    /// Count the owned family payload once at its canonical input, not at shared query results.
+    fn estimated_heap_size(&self) -> usize {
+        match self {
+            Self::Object(value) => value.estimated_heap_size(),
+            Self::Register(value) => value.estimated_heap_size(),
+            Self::CommonModule(value) => value.estimated_heap_size(),
+            Self::DefinedType(value) => value.estimated_heap_size(),
+        }
+    }
+}
+
+/// A host-provided metadata value; None means pending or unavailable, never XML fallback.
+/// The source revision addresses exact input bytes independently of semantic equality.
+#[salsa::input(debug, heap_size = heap_estimate::canonical_metadata_input_heap)]
+pub struct CanonicalMetadataInput {
+    pub value: Option<Arc<CanonicalMetadata>>,
+    pub source_revision: String,
+}
+
+/// Stable main-file identities map to mutable Salsa inputs, not untracked payloads.
+pub type CanonicalMetadataInputs = FxHashMap<vfs::FileId, CanonicalMetadataInput>;
