+    let executions = db.salsa_family_churn("resolve_metadata_object").expect("events").0;
+    assert_eq!(executions, 2);
+    first.set_value(&mut db).to(None);
+    first.set_source_revision(&mut db).to("changed".into());
+    let retained = resolve_metadata_object(&db, listing, MdoType::Catalog, "Second".into())
+        .expect("cached sibling");
+    assert!(Arc::ptr_eq(&sibling, &retained));
+    assert_eq!(db.salsa_family_churn("resolve_metadata_object").expect("events").0, executions);
+}
