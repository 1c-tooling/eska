+/// Changing one provided object must not re-execute resolution for its sibling.
+#[test]
+fn canonical_mdo_keeps_unrelated_resolution_memoized() {
+    use crate::metadata::{
+        resolve_metadata_object, CanonicalMdoInput, CanonicalMdoInputs, MdoEntry,
+    };
+    use bsl_metadata::{MdoType, MetadataObject};
+    use salsa::Setter;
+
+    let mut db = RootDatabaseImpl::new_with_salsa_events();
+    db.set_metadata_listing(
+        "/canonical",
+        MetadataListingData {
+            entries: ["First", "Second"]
+                .into_iter()
+                .enumerate()
+                .map(|(index, name)| MdoEntry {
+                    kind: MdoType::Catalog,
+                    name: name.into(),
+                    main: FileId(index as u32),
+                    predefined: None,
+                })
+                .collect(),
+            ..MetadataListingData::default()
+        },
+    );
+    let listing = db.metadata_listing("/canonical").expect("registered listing");
+    let first = CanonicalMdoInput::new(
+        &db,
+        Some(Arc::new(MetadataObject::new(MdoType::Catalog, "First"))),
+        "first".into(),
+    );
+    let second = CanonicalMdoInput::new(
+        &db,
+        Some(Arc::new(MetadataObject::new(MdoType::Catalog, "Second"))),
+        "second".into(),
+    );
+    let inputs: CanonicalMdoInputs =
+        [(FileId(0), first), (FileId(1), second)].into_iter().collect();
+    listing.set_canonical_mdos(&mut db).to(Arc::new(inputs));
+    assert!(resolve_metadata_object(&db, listing, MdoType::Catalog, "First".into()).is_some());
+    let sibling =
+        resolve_metadata_object(&db, listing, MdoType::Catalog, "Second".into()).expect("sibling");
+    let executions = db.salsa_family_churn("resolve_metadata_object").expect("events").0;
+    assert_eq!(executions, 2);
+    first.set_value(&mut db).to(None);
+    first.set_source_revision(&mut db).to("changed".into());
+    let retained = resolve_metadata_object(&db, listing, MdoType::Catalog, "Second".into())
+        .expect("cached sibling");
+    assert!(Arc::ptr_eq(&sibling, &retained));
+    assert_eq!(db.salsa_family_churn("resolve_metadata_object").expect("events").0, executions);
+}
