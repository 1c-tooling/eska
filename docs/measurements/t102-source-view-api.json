  "behavior": {
    "policy": "Core combines known Designer ownership, support policy, filesystem state, adapter-reported user restriction and all live source-session owners. The explicit ordinary support opt-out never bypasses source ownership. Query application has no support opt-out.",
    "snapshot": "A read-only immutable view returns exact raw disk bytes, an explicitly supplied native UTF-8 buffer, or the full retained query owner in that priority order reversed: active query owner, supplied native buffer, disk. Query views retain text, not an owned write lease.",
    "bounds": "8 MiB per snapshot, 16 live views, 128 KiB per chunk, 128 protection paths, 32 MiB retained bytes and 64 entries shared with query sessions/uploads; no new unbounded memory store.",
    "scope": "Source identities and exact project context stay in core/RPC. Views reject foreign process/member handles, wrong hashes, oversized or non-canonical chunks; immutable reads and cleanup permit stale generations. Binary content is not silently decoded.",
    "nativeWrites": "Explorer requests the common decision before language write operations and checks captured process, source ownership epoch, metadata generation/event sequence and native versions before applying. Support disabled still requires common ownership checks.",
    "compatibility": "API 1.16 fallback keeps durable XML sessions on the same child. Older backend language read providers remain available; language writes require the new protection capability.",
    "remaining": "The general eska-protected FileSystemProvider still reads through workspace.fs. Its backend migration and native BSL owner freeze preserving user overrides are not accepted by this part.",
    "backendWritesOwner": false,
    "newDependencies": false
  },
